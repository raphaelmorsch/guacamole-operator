{
  "name": "guacamole-desktop-portal",
  "version": "0.0.15",
  "description": "OpenShift Console plugin to allocate Guacamole DesktopSessions from Keycloak users",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production webpack",
    "http-server": "http-server dist -p 9001 -c-1 --cors"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.8.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.3.0",
    "@patternfly/react-core": "^5.4.0",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.37",
    "@types/react-router-dom": "^5.3.2",
    "ajv": "^8.17.1",
    "css-loader": "^6.7.1",
    "http-server": "^14.1.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.3.1",
    "typescript": "^4.7.4",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "consolePlugin": {
    "name": "guacamole-desktop-portal",
    "version": "0.0.15",
    "displayName": "Guacamole Desktop Portal",
    "description": "Allocate DesktopSessions to Keycloak users",
    "exposedModules": {
      "DesktopSessionsPage": "./src/components/DesktopSessionsPage.tsx"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}

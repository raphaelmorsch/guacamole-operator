# Build the desktop portal API binary.
FROM golang:1.21 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/portal-api/ cmd/portal-api/
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o portal-api ./cmd/portal-api

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/portal-api .
USER 65532:65532
ENTRYPOINT ["/portal-api"]
